   <!-- Page Header Start -->
      <div class="container-fluid bg-secondary mb-5 py-5">
        <div class="row justify-content-center text-center">
          <div class="col-lg-8">
            <h2 class="font-weight-bold text-uppercase mb-0">My Addresses</h2>
            <p class="text-muted mt-2">Manage your delivery addresses</p>
          </div>
        </div>
      </div>
      <!-- Page Header End -->

      <!-- Addresses List Start -->
      <div class="container-fluid pb-5">
        <div class="row px-xl-5 justify-content-center">
          <% if (addresses && addresses.length > 0) { %>
            <% addresses.forEach(function(address) { %>
              <div class="col-lg-4 col-md-6 col-sm-12 mb-4">
                <div class="card border-0 shadow h-100 hover-lift position-relative">
                  <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                      <h5 class="font-weight-bold mb-0">
                        <%= address.firstName %> <%= address.lastName %>
                      </h5>
                      <div class="text-right">
                        <a
                          href="#"
                          class="text-primary mr-3 edit-address"
                          data-toggle="modal"
                          data-target="#editAddressModal"
                          data-address="<%= JSON.stringify(address) %>"
                        >
                          <i class="fas fa-edit fa-lg"></i>
                        </a>
                        <a href="/deleteAddress?id=<%= address._id %>" class="text-danger">
                          <i class="fas fa-trash fa-lg"></i>
                        </a>
                      </div>
                    </div>
                    <p class="text-muted mb-1">
                      <i class="fas fa-envelope mr-2"></i><%= address.shippingEmail %>
                    </p>
                    <p class="text-muted mb-1">
                      <i class="fas fa-phone mr-2"></i><%= address.mobile %>
                    </p>
                    <p class="text-muted mb-0">
                      <i class="fas fa-map-marker-alt mr-2"></i>
                      <%= address.street %>, <%= address.city %>,<br>
                      <%= address.state %>, <%= address.country %> - <%= address.postalCode %>
                    </p>
                  </div>
                </div>
              </div>
            <% }) %>
          <% } else { %>
            <div class="col-12 text-center py-5">
              <i class="fas fa-map-marker-alt fa-4x text-muted mb-4"></i>
              <h4 class="text-muted">No addresses saved yet</h4>
              <p class="text-muted">Add your first delivery address below</p>
            </div>
          <% } %>
        </div>
      </div>
      <!-- Addresses List End -->

      <!-- Add New Address Section Start -->
      <div class="container-fluid bg-light py-5">
        <div class="row px-xl-5 justify-content-center">
          <div class="col-lg-8 col-md-10">
            <div class="card border-0 shadow">
              <div class="card-header bg-white border-0">
                <h4 class="font-weight-bold mb-0">
                  <i class="fas fa-plus-circle mr-2 text-dark"></i>Add New Address
                </h4>
              </div>
              <div class="card-body p-4">
                <% if (errors && errors.length > 0) { %>
                  <div class="alert alert-danger">
                    <% errors.forEach(function(error) { %>
                      <p class="mb-1"><%= error.msg %></p>
                    <% }) %>
                  </div>
                <% } %>

                <form action="/addAddress" method="post">
                  <div class="row">
                    <div class="col-md-6 form-group">
                      <label>First Name <span class="text-danger">*</span></label>
                      <input class="form-control" type="text" name="firstName" required minlength="3" maxlength="30" placeholder="John" />
                    </div>
                    <div class="col-md-6 form-group">
                      <label>Last Name <span class="text-danger">*</span></label>
                      <input class="form-control" type="text" name="lastName" required minlength="1" maxlength="20" placeholder="Doe" />
                    </div>
                    <div class="col-md-6 form-group">
                      <label>E-mail <span class="text-danger">*</span></label>
                      <input class="form-control" type="email" name="shippingEmail" required placeholder="example@email.com" />
                    </div>
                    <div class="col-md-6 form-group">
                      <label>Mobile No <span class="text-danger">*</span></label>
                      <input class="form-control" type="text" name="mobile" required minlength="10" maxlength="10" placeholder="9876543210" />
                    </div>
                    <div class="col-md-6 form-group">
                      <label>Country <span class="text-danger">*</span></label>
                      <input class="form-control" type="text" name="country" required placeholder="India" />
                    </div>
                    <div class="col-md-6 form-group">
                      <label>State <span class="text-danger">*</span></label>
                      <input class="form-control" type="text" name="state" required placeholder="Kerala" />
                    </div>
                    <div class="col-md-6 form-group">
                      <label>City <span class="text-danger">*</span></label>
                      <input class="form-control" type="text" name="city" required placeholder="Kochi" />
                    </div>
                    <div class="col-md-6 form-group">
                      <label>Street Address <span class="text-danger">*</span></label>
                      <input class="form-control" type="text" name="street" required placeholder="123 Main Street" />
                    </div>
                    <div class="col-md-6 form-group">
                      <label>Postal Code <span class="text-danger">*</span></label>
                      <input class="form-control" type="text" name="postalCode" required minlength="6" maxlength="6" placeholder="682001" />
                    </div>
                    <div class="col-12 text-center mt-4">
                      <button type="submit" class="btn btn-success btn-lg px-5">
                        <i class="fas fa-save mr-2"></i>Add Address
                      </button>
                    </div>
                  </div>
                </form>
              </div>
            </div>
          </div>
        </div>
      </div>
      <!-- Add New Address Section End -->

      <!-- Edit Address Modal (unchanged logic, minor style tweaks) -->
      <div class="modal fade" id="editAddressModal" tabindex="-1" role="dialog" aria-labelledby="editAddressModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg" role="document">
          <div class="modal-content border-0 shadow">
            <div class="modal-header bg-light">
              <h5 class="modal-title font-weight-bold" id="editAddressModalLabel">
                <i class="fas fa-edit mr-2"></i>Edit Address
              </h5>
              <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                <span aria-hidden="true">&times;</span>
              </button>
            </div>
            <div class="modal-body">
              <form action="/editAddress" method="post" id="editAddressForm">
                <div class="row">
                  <div class="col-md-6 form-group">
                    <label>First Name</label>
                    <input class="form-control" type="text" name="firstName" id="editFirstName" required minlength="3" maxlength="30" />
                  </div>
                  <div class="col-md-6 form-group">
                    <label>Last Name</label>
                    <input class="form-control" type="text" name="lastName" id="editLastName" required minlength="1" maxlength="20" />
                  </div>
                  <div class="col-md-6 form-group">
                    <label>E-mail</label>
                    <input class="form-control" type="email" name="shippingEmail" id="editEmail" required />
                  </div>
                  <div class="col-md-6 form-group">
                    <label>Mobile No</label>
                    <input class="form-control" type="text" name="mobile" id="editMobile" required minlength="10" maxlength="10" />
                  </div>
                  <div class="col-md-6 form-group">
                    <label>Country</label>
                    <input class="form-control" type="text" name="country" id="editCountry" required />
                  </div>
                  <div class="col-md-6 form-group">
                    <label>State</label>
                    <input class="form-control" type="text" name="state" id="editState" required />
                  </div>
                  <div class="col-md-6 form-group">
                    <label>City</label>
                    <input class="form-control" type="text" name="city" id="editCity" required />
                  </div>
                  <div class="col-md-6 form-group">
                    <label>Street</label>
                    <input class="form-control" type="text" name="street" id="editStreet" required />
                  </div>
                  <div class="col-md-6 form-group">
                    <label>Postal Code</label>
                    <input class="form-control" type="text" name="postalCode" id="editPostalCode" required minlength="6" maxlength="6" />
                  </div>
                  <input type="hidden" name="addressId" id="editAddressId" />
                  <div class="col-12 text-center mt-4">
                    <button type="submit" class="btn btn-success btn-lg px-5">
                      <i class="fas fa-save mr-2"></i>Save Changes
                    </button>
                  </div>
                </div>
              </form>
            </div>
          </div>
        </div>
      </div>

    <!-- Footer Start -->
    <div class="container-fluid bg-secondary text-dark mt-5 pt-5">
      <div class="row px-xl-5 pt-5">
        <div class="col-lg-4 col-md-12 mb-5 pr-3 pr-xl-5">
