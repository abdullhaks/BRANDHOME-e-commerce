                >
                <a class="text-dark mb-2" href="/cart"
                  ><i class="fa fa-angle-right mr-2"></i>Shopping Cart</a
                >
                <a class="text-dark mb-2" href="/checkOut"
                  ><i class="fa fa-angle-right mr-2"></i>Checkout</a
                >
                <a class="text-dark" href="https://wa.me/8594043859"
                  ><i class="fa fa-angle-right mr-2"></i>Contact Us</a
                >
              </div>
            </div>
            <div class="col-md-4 mb-5">
              <h5 class="font-weight-bold text-dark mb-4">Quick Links</h5>
              <div class="d-flex flex-column justify-content-start">
                <a class="text-dark mb-2" href="/orders"
                  ><i class="fa fa-angle-right mr-2"></i>My Orders</a
                >
                <a class="text-dark mb-2" href="/profile"
                  ><i class="fa fa-angle-right mr-2"></i>Profile</a
                >
                <a class="text-dark mb-2" href="/addresses"
                  ><i class="fa fa-angle-right mr-2"></i>Addresses</a
                >
                <a class="text-dark mb-2" href="/wishList"
                  ><i class="fa fa-angle-right mr-2"></i>WishList</a
                >
              </div>
            </div>
         
          </div>
        </div>
      </div>
      <div class="row border-top border-light mx-xl-5 py-4">
        <div class="col-md-6 px-xl-0">
          <p class="mb-md-0 text-center text-md-left text-dark">
            &copy;
            <a class="text-dark font-weight-semi-bold" href="#">BRANDHOME</a>.
            All Rights Reserved. Designed by
            <a
              class="text-dark font-weight-semi-bold"
              href="https://www.instagram.com/abdullha_kalamban?igsh=MXJ3ODBxYnJncWFqcg%3D%3D&utm_source=qr"
              >aks_designs</a
            ><br />
            Distributed By
            <a
              href="https://www.instagram.com/abdullha_kalamban?igsh=MXJ3ODBxYnJncWFqcg%3D%3D&utm_source=qr"
              target="_blank"
              >AKS4U WEB-SOLUTIONS</a
            >
          </p>
        </div>
        <div class="col-md-6 px-xl-0 text-center text-md-right">
          <img class="img-fluid" src="/images/payments.png" alt="" />
        </div>
      </div>
    </div>
    <!-- Footer End -->

    <!-- Back to Top -->
    <a href="#" class="btn btn-primary back-to-top"
      ><i class="fa fa-angle-double-up"></i
    ></a>

    <!-- JavaScript Libraries -->
    <script src="https://code.jquery.com/jquery-3.4.1.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.4.1/js/bootstrap.bundle.min.js"></script>
    <script src="/lib/easing/easing.min.js"></script>
    <script src="/lib/owlcarousel/owl.carousel.min.js"></script>

    <!-- Contact Javascript File -->
    <script src="/mail/jqBootstrapValidation.min.js"></script>
    <script src="/mail/contact.js"></script>

    <!-- Template Javascript -->
    <script src="/js/main.js"></script>
  </body>

  <script>
    $(document).on("click", ".edit-address", function (e) {
      e.preventDefault();

      // Get the address data from the button's data-address attribute
      const address = $(this).data("address");

      // Populate the modal form fields with the address data
      $('#editAddressModal input[name="firstName"]').val(address.firstName);
      $('#editAddressModal input[name="lastName"]').val(address.lastName);
      $('#editAddressModal input[name="shippingEmail"]').val(
        address.shippingEmail
      );
      $('#editAddressModal input[name="mobile"]').val(address.mobile);
      $('#editAddressModal input[name="country"]').val(address.country);
      $('#editAddressModal input[name="state"]').val(address.state);
      $('#editAddressModal input[name="city"]').val(address.city);
      $('#editAddressModal input[name="street"]').val(address.street);
      $('#editAddressModal input[name="postalCode"]').val(address.postalCode);

      // Set the form action URL to include the address ID
      $("#editAddressModal form").attr(
        "action",
        `/editAddress?id=${address._id}`
      );
    });
  </script>
</html>
