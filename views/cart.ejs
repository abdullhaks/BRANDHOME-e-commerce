<script>
document.addEventListener('DOMContentLoaded', async function () {
            await checkStockAndUpdateLimit();
            updateAllTotals();
            bindQuantityButtons();
            bindRemoveButtons();
        });

        // Check stock and set limits
        async function checkStockAndUpdateLimit() {
            const cartItems = document.querySelectorAll('tr[id^="cartItem"]');
            let hasOutOfStock = false;

            for (let i = 0; i < cartItems.length; i++) {
                const productId = document.querySelector(`input[name="productId${i}"]`).value;
                const size = document.querySelector(`#size${i}`).value;
                const color = document.querySelector(`#color${i}`).value;

                try {
                    const response = await fetch(`/getStock?productId=${productId}&size=${size}&color=${color}`);
                    const data = await response.json();

                    const limit = data.quantity < 5 ? data.quantity : 5;
                    document.getElementById(`limit${i}`).value = limit;

                    if (data.quantity <= 0) {
                        document.getElementById(`stockAlert${i}`).classList.remove('d-none');
                        hasOutOfStock = true;
                        document.getElementById(`quantity${i}`).value = 0;
                    } else {
                        document.getElementById(`stockAlert${i}`).classList.add('d-none');
                    }
                } catch (error) {
                    console.error("Stock check error:", error);
                }
            }

            if (hasOutOfStock) {
                document.getElementById('stockAlert').classList.remove('d-none');
                document.getElementById('checkoutButton').disabled = true;
            } else {
                document.getElementById('stockAlert').classList.add('d-none');
                document.getElementById('checkoutButton').disabled = false;
            }
        }

        // Update individual item total and grand total
        function updateItemTotal(index) {
            const price = parseFloat(document.querySelector(`input[name="productPrice${index}"]`).value);
            const quantity = parseInt(document.getElementById(`quantity${index}`).value) || 0;
            const total = price * quantity;
            document.getElementById(`totalPrice${index}`).innerText = `Rs ${total.toFixed(2)}`;
        }

        function updateGrandTotal() {
            let grandTotal = 0;
            document.querySelectorAll('tr[id^="cartItem"]').forEach((row, i) => {
                const totalText = document.getElementById(`totalPrice${i}`)?.innerText || "Rs 0";
                grandTotal += parseFloat(totalText.replace('Rs ', '')) || 0;
            });
            document.getElementById('grandTotal').innerText = `Rs ${grandTotal.toFixed(2)}`;
            document.getElementById('totalAmount').value = grandTotal.toFixed(2);
        }

        function updateAllTotals() {
            document.querySelectorAll('tr[id^="cartItem"]').forEach((_, i) => updateItemTotal(i));
            updateGrandTotal();
        }

        // Bind + / - buttons
        function bindQuantityButtons() {
            document.querySelectorAll('.increase-btn').forEach(btn => {
                btn.onclick = function() {
                    const index = this.dataset.index;
                    const qtyInput = document.getElementById(`quantity${index}`);
                    const limit = parseInt(document.getElementById(`limit${index}`).value);

                    if (parseInt(qtyInput.value) < limit) {
                        qtyInput.value = parseInt(qtyInput.value) + 1;
                        updateItemTotal(index);
                        updateGrandTotal();

                        if (qtyInput.value > 1) {
                            document.querySelector(`.decrease-btn[data-index="${index}"]`).style.display = 'inline';
                        }
                        if (qtyInput.value >= limit) {
                            this.style.display = 'none';
                        }
                    }
                };
            });

            document.querySelectorAll('.decrease-btn').forEach(btn => {
                btn.onclick = function() {
                    const index = this.dataset.index;
                    const qtyInput = document.getElementById(`quantity${index}`);

                    if (parseInt(qtyInput.value) > 1) {
                        qtyInput.value = parseInt(qtyInput.value) - 1;
                        updateItemTotal(index);
                        updateGrandTotal();

                        document.querySelector(`.increase-btn[data-index="${index}"]`).style.display = 'inline';
                        if (qtyInput.value <= 1) {
                            this.style.display = 'none';
                        }
                    }
                };
            });
        }

        // Use event delegation for remove buttons
        function bindRemoveButtons() {
            document.getElementById('cartTable').addEventListener('click', function(e) {
                if (e.target.closest('.removeCartItems')) {
                    const btn = e.target.closest('.removeCartItems');
                    const productId = btn.dataset.productid;
                    const color = btn.dataset.color;
                    const size = btn.dataset.size;
                    const index = btn.dataset.index;

                    removeProductFromCart(productId, color, size, index);
                }
            });
        }

        // Remove item with confirmation
        async function removeProductFromCart(productId, color, size, index) {
            Swal.fire({
                title: 'Remove Item?',
                text: "This item will be removed from your cart.",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes, remove it',
                cancelButtonText: 'Cancel'
            }).then(async (result) => {
                if (result.isConfirmed) {
                    try {
                        const response = await fetch(`/removeFromCart?productId=${productId}&color=${color}&size=${size}`, {
                            method: 'DELETE'
                        });
                        const data = await response.json();

                        if (data.success) {
                            // Rebuild cart table
                            const cartTable = document.getElementById('cartTable');
                            cartTable.innerHTML = '';

                            if (data.products.length === 0) {
                                cartTable.innerHTML = '<tr><td colspan="7">No products in the cart.</td></tr>';
                                document.getElementById('grandTotal').innerText = 'Rs 0';
                                document.querySelector('.card-footer .btn-primary').style.display = 'none';
                            } else {
                                data.products.forEach((product, i) => {
                                    const variant = data.variants[i];
                                    const qty = document.getElementById(`quantity${index}`)?.value || 1; // fallback

                                    cartTable.innerHTML += `
                                        <tr id="cartItem${i}">
                                            <td class="align-middle">
                                                <img src="/productImages/${product.image1}" alt="" style="width: 50px;">
                                                ${product.productName}
                                                <input type="hidden" value="${product._id}" name="productId${i}">
                                                <input type="hidden" value="${product.productName}" name="productName${i}">
                                                <input type="hidden" value="${product.brand}" name="productBrand${i}">
                                                <input type="hidden" value="${product.price}" name="productPrice${i}">
                                                <input type="hidden" value="${product.categoryOfferPercentage + product.productOfferPercentage}" name="totalOffer${i}">
                                                <input type="hidden" value="${product.image1}" name="productImage${i}">
                                                <input type="hidden" value="${(product.categoryOfferPercentage + product.productOfferPercentage) * product.price / 100}" name="save${i}">
                                            </td>
                                            <td class="align-middle" id="pricePerUnit${i}">Rs ${product.price}</td>
                                            <td class="align-middle">${variant.size}
                                                <input type="hidden" name="option${i}" id="size${i}" value="${variant.size}">
                                            </td>
                                            <td class="align-middle">${variant.color}
                                                <input type="hidden" name="color${i}" id="color${i}" value="${variant.color}">
                                            </td>
                                            <td class="align-middle">
                                                <div class="d-flex align-items-center justify-content-center">
                                                    <a class="btn btn-sm btn-dark decrease-btn" data-index="${i}" style="min-width: 36px;">
                                                        <i class="fas fa-minus"></i>
                                                    </a>
                                                    <input type="number" value="${qty}" name="quantity${i}" id="quantity${i}"
                                                           class="form-control text-center mx-2" style="max-width: 60px;" readonly>
                                                    <a class="btn btn-sm btn-dark increase-btn" data-index="${i}" style="min-width: 36px;">
                                                        <i class="fas fa-plus"></i>
                                                    </a>
                                                    <input type="hidden" id="limit${i}" value="5">
                                                </div>
                                                <div class="text-center mt-2 d-none" id="stockAlert${i}">
                                                    <span class="text-danger">Out of stock</span>
                                                </div>
                                            </td>
                                            <td class="align-middle" id="totalPrice${i}">Rs ${product.price * qty}</td>
                                            <td class="align-middle">
                                                <a class="btn btn-sm text-dark p-0 removeCartItems"
                                                   data-productid="${product._id}"
                                                   data-color="${variant.color}"
                                                   data-size="${variant.size}"
                                                   data-index="${i}">
                                                    <i class="fas fa-times text-primary mr-1"></i>
                                                </a>
                                            </td>
                                        </tr>`;
                                });
                            }

                            await checkStockAndUpdateLimit();
                            updateAllTotals();
                            bindQuantityButtons(); // Re-bind after DOM update
                        }
                    } catch (error) {
                        console.error("Remove error:", error);
                        Swal.fire('Error', 'Failed to remove item', 'error');
                    }
                }
            });
        }

</script>


    


