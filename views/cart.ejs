       <form action="/cart" method="post">
        <div class="container-fluid pt-5">
            <div class="row px-xl-5">
                <div class="col-lg-12 table-responsive mb-5">
                    <table class="table table-bordered text-center mb-0">
                        <thead class="bg-secondary text-dark">
                            <tr>
                                <th>Products</th>
                                <th>Price</th>
                                <th>Size</th>
                                <th>Color</th>
                                <th>Quantity</th>
                                <th>Total</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody class="align-middle" id="cartTable">
                            <% if (products.length > 0) {
                                for (let i = 0; i < products.length; i++) { %>
                            <tr id="cartItem<%= i %>">
                                <td class="align-middle">
                                    <img src="/productImages/<%= products[i].image1 %>" alt="" style="width: 50px;">
                                    <%= products[i].productName %>
                                    <input type="hidden" value="<%= products[i]._id %>" name="productId<%= i %>">
                                    <input type="hidden" value="<%= products[i].productName %>" name="productName<%= i %>">
                                    <input type="hidden" value="<%= products[i].brand %>" name="productBrand<%= i %>">
                                    <input type="hidden" value="<%= products[i].price %>" name="productPrice<%= i %>">
                                    <input type="hidden" value="<%= products[i].categoryOfferPercentage + products[i].productOfferPercentage %>" name="totalOffer<%= i %>">
                                    <input type="hidden" value="<%= products[i].image1 %>" name="productImage<%= i %>">
                                    <input type="hidden" value="<%= (products[i].categoryOfferPercentage + products[i].productOfferPercentage) * products[i].price / 100 %>" name="save<%= i %>">
                                </td>
                                <td class="align-middle" id="pricePerUnit<%= i %>">Rs <%= products[i].price %></td>
                                <td class="align-middle">
                                    <%= variants[i].size %>
                                    <input type="hidden" name="option<%= i %>" id="size<%= i %>" value="<%= variants[i].size %>">
                                </td>
                                <td class="align-middle">
                                    <%= variants[i].color %>
                                    <input type="hidden" name="color<%= i %>" id="color<%= i %>" value="<%= variants[i].color %>">
                                </td>
                                <td class="align-middle">
                                    <div class="d-flex align-items-center justify-content-center">
                                        <a class="btn btn-sm btn-dark decrease-btn" data-index="<%= i %>" style="min-width: 36px;">
                                            <i class="fas fa-minus"></i>
                                        </a>
                                        <input type="number" value="1" name="quantity<%= i %>" id="quantity<%= i %>"
                                               class="form-control text-center mx-2" style="max-width: 60px;" readonly>
                                        <a class="btn btn-sm btn-dark increase-btn" data-index="<%= i %>" style="min-width: 36px;">
                                            <i class="fas fa-plus"></i>
                                        </a>
                                        <input type="hidden" id="limit<%= i %>" value="5">
                                    </div>
                                    <div class="text-center mt-2 d-none" id="stockAlert<%= i %>">
                                        <span class="text-danger">Out of stock</span>
                                    </div>
                                </td>
                                <td class="align-middle" id="totalPrice<%= i %>">Rs <%= products[i].price %></td>
                                <td class="align-middle">
                                    <a class="btn btn-sm text-dark p-0 removeCartItems"
                                       data-productid="<%= products[i]._id %>"
                                       data-color="<%= variants[i].color %>"
                                       data-size="<%= variants[i].size %>"
                                       data-index="<%= i %>">
                                        <i class="fas fa-times text-primary mr-1"></i>
                                    </a>
                                </td>
                            </tr>
                            <% } } else { %>
                            <tr>
                                <td colspan="7">No products in the cart.</td>
                            </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

